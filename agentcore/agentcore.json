{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "RefundAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "RefundAgent",
    "owner": "mateo",
    "project": "agentcore-workshop-customer-service",
    "environment": "workshop"
  },
  "runtimes": [
    {
      "name": "RefundAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/RefundAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "RefundMemory",
      "eventExpiryDuration": 30,
      "strategies": []
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "PaymentGateway",
      "protocolType": "MCP",
      "description": "Gateway for PaymentGateway",
      "targets": [
        {
          "name": "payment",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "list_orders",
              "description": "List the signed-in customer's orders.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "customer": {
                    "type": "string",
                    "description": "The signed-in customer; the policy binds this to your verified identity."
                  }
                },
                "required": [
                  "customer"
                ]
              }
            },
            {
              "name": "lookup_order",
              "description": "Look up the status and amount of one of the customer's orders.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "customer": {
                    "type": "string",
                    "description": "The signed-in customer; the policy binds this to your verified identity."
                  },
                  "order_id": {
                    "type": "string",
                    "description": "The order identifier, e.g. \"A-1001\"."
                  }
                },
                "required": [
                  "customer",
                  "order_id"
                ]
              }
            },
            {
              "name": "process_refund",
              "description": "Issue a (simulated) refund for a delivered order the customer owns. Safe to retry.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "customer": {
                    "type": "string",
                    "description": "The signed-in customer; the policy binds this to your verified identity."
                  },
                  "order_id": {
                    "type": "string",
                    "description": "The order identifier, e.g. \"A-1001\"."
                  },
                  "amount": {
                    "type": "number",
                    "description": "Refund amount in dollars."
                  }
                },
                "required": [
                  "customer",
                  "order_id",
                  "amount"
                ]
              }
            },
            {
              "name": "get_refund_status",
              "description": "Report the (simulated) settled status of a refund for an order the customer owns.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "customer": {
                    "type": "string",
                    "description": "The signed-in customer; the policy binds this to your verified identity."
                  },
                  "order_id": {
                    "type": "string",
                    "description": "The order identifier, e.g. \"A-1001\"."
                  }
                },
                "required": [
                  "customer",
                  "order_id"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "infra/payment",
              "handler": "handler.lambda_handler"
            },
            "pythonVersion": "PYTHON_3_12",
            "timeout": 30,
            "memorySize": 128
          }
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}