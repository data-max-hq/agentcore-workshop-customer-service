{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "PolicySessionWorkloadIdentity",
    "Effect": "Allow",
    "Action": "bedrock-agentcore:GetWorkloadAccessToken",
    "Resource": [
      "arn:aws:bedrock-agentcore:eu-central-1:*:workload-identity-directory/default",
      "arn:aws:bedrock-agentcore:eu-central-1:*:workload-identity-directory/default/workload-identity/*"
    ]
  }]
}
