          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Two doors into the same Lambda" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="1030" width="760" height="78" as="geometry" />
        </mxCell>
        <mxCell id="leg-chat" value="" style="rounded=0;html=1;fillColor=#2F6FDB;strokeColor=none;" vertex="1" parent="legend">
          <mxGeometry x="10" y="35" width="30" height="4" as="geometry" />
        </mxCell>
        <mxCell id="leg-chat-t" value="Chat door, through the agent: refund-gw sees only the agent's role, so it can't tell alice from bob." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="legend">
          <mxGeometry x="50" y="27" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg-tools" value="" style="rounded=0;html=1;fillColor=#E8730C;strokeColor=none;" vertex="1" parent="legend">
