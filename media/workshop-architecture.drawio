<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Workshop architecture" id="refund-agent-arch">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Refund agent on Amazon Bedrock AgentCore: what you build in this workshop" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Built by hand in the AWS console, us-east-1. M1 to M5 are the lab modules that create each piece." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1200" height="24" as="geometry" />
        </mxCell>

        <!-- Customer -->
        <mxCell id="customer" value="Customer&#xa;alice / bob" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.authenticated_user;" vertex="1" parent="1">
          <mxGeometry x="40" y="428" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- Tester page in the browser -->
        <mxCell id="page" value="Tester page (browser)" style="swimlane;startSize=30;rounded=1;arcSize=4;html=1;whiteSpace=wrap;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#fafafa;strokeColor=#666666;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="100" width="220" height="720" as="geometry" />
        </mxCell>
        <mxCell id="signin" value="Sign in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontStyle=1;" vertex="1" parent="page">
          <mxGeometry x="20" y="42" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="chattab" value="Chat tab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2F6FDB;strokeWidth=2;fontStyle=1;" vertex="1" parent="page">
          <mxGeometry x="20" y="295" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="toolstab" value="Tools tab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E8730C;strokeWidth=2;fontStyle=1;" vertex="1" parent="page">
          <mxGeometry x="20" y="615" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- AWS region -->
        <mxCell id="region" value="us-east-1 · your AWS account" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="1400" height="920" as="geometry" />
        </mxCell>

        <!-- M1 Cognito -->
        <mxCell id="cognito" value="Cognito user pool (M1)&#xa;issues your JWT" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="region">
          <mxGeometry x="228" y="60" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- M2 Harness with model and M3 memory -->
        <mxCell id="harness" value="AgentCore Harness · refund_&amp;lt;initials&amp;gt; (M2)" style="swimlane;startSize=30;rounded=1;arcSize=4;html=1;whiteSpace=wrap;collapsible=0;fillColor=#C8EDE6;swimlaneFillColor=#F0FAF8;strokeColor=#01A88D;strokeWidth=2;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="region">
          <mxGeometry x="80" y="220" width="360" height="250" as="geometry" />
        </mxCell>
        <mxCell id="harness-txt" value="Inbound auth: JWT from your Cognito pool&#xa;The system prompt says who you are" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="harness">
          <mxGeometry x="12" y="34" width="336" height="40" as="geometry" />
        </mxCell>
        <mxCell id="nova" value="Amazon Nova Pro&#xa;(model)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nova2;" vertex="1" parent="harness">
          <mxGeometry x="70" y="100" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="memory" value="AgentCore Memory (M3)&#xa;short and long term, per user" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="harness">
          <mxGeometry x="226" y="100" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- M4 IAM gateway -->
        <mxCell id="gw" value="refund-gw (M4) · AgentCore Gateway" style="swimlane;startSize=30;rounded=1;arcSize=4;html=1;whiteSpace=wrap;collapsible=0;fillColor=#C8EDE6;swimlaneFillColor=#F0FAF8;strokeColor=#01A88D;strokeWidth=2;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="region">
          <mxGeometry x="580" y="280" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gw-txt" value="Inbound auth: AWS IAM&#xa;Sees the agent's role, not you&#xa;No policy engine" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="gw">
          <mxGeometry x="12" y="36" width="336" height="80" as="geometry" />
        </mxCell>

        <!-- Tester Lambda -->
        <mxCell id="tester" value="refund_ui Lambda (the tester)&#xa;Function URL: serves the page, /mcp proxy" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="region">
          <mxGeometry x="228" y="633" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- M5 JWT gateway with policy engine -->
        <mxCell id="gwjwt" value="refund-gw-jwt (M5) · AgentCore Gateway" style="swimlane;startSize=30;rounded=1;arcSize=4;html=1;whiteSpace=wrap;collapsible=0;fillColor=#C8EDE6;swimlaneFillColor=#F0FAF8;strokeColor=#01A88D;strokeWidth=2;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="region">
          <mxGeometry x="580" y="560" width="360" height="316" as="geometry" />
        </mxCell>
        <mxCell id="gwjwt-txt" value="Inbound auth: JWT from your Cognito pool&#xa;Sees you: the username on your token" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="gwjwt">
          <mxGeometry x="12" y="36" width="336" height="44" as="geometry" />
        </mxCell>
        <mxCell id="pe" value="Policy engine · ENFORCE" style="swimlane;startSize=28;rounded=1;arcSize=4;html=1;whiteSpace=wrap;collapsible=0;fillColor=#e1d5e7;swimlaneFillColor=#FBF8FC;strokeColor=#9673a6;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="gwjwt">
          <mxGeometry x="12" y="92" width="336" height="212" as="geometry" />
        </mxCell>
        <mxCell id="pol-identity" value="&lt;b&gt;Cedar · identity binding&lt;/b&gt;&lt;br&gt;customer_id must equal your username" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="pe">
          <mxGeometry x="12" y="36" width="312" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pol-cap" value="&lt;b&gt;Cedar · refund cap&lt;/b&gt;&lt;br&gt;no refund over $200, whoever asks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="pe">
          <mxGeometry x="12" y="94" width="312" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pol-dogwood" value="&lt;b&gt;Dogwood · refund after lookup&lt;/b&gt;&lt;br&gt;no refund unless you opened that order earlier this session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="pe">
          <mxGeometry x="12" y="152" width="312" height="50" as="geometry" />
        </mxCell>

        <!-- M4 tools Lambda -->
        <mxCell id="tools" value="&lt;b&gt;refund_tool Lambda (M4)&lt;/b&gt;&lt;br&gt;find_orders · get_order_transaction&lt;br&gt;process_refund · get_refund_status&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;hardcoded orders&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=middle;labelPosition=right;verticalAlign=middle;align=left;spacingLeft=6;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="region">
          <mxGeometry x="1048" y="473" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- Edges: sign-in (grey) -->
        <mxCell id="e-customer-page" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;endArrow=block;endSize=8;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="customer" target="page">
