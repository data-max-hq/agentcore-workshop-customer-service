        <mxCell id="e-gw-tools" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2F6FDB;endArrow=block;endSize=8;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="tools">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: Tools door (orange) -->
        <mxCell id="e-toolstab-tester" value="POST /mcp + your JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#E8730C;endArrow=block;endSize=8;endFill=1;fontSize=11;fontColor=#B85A08;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="toolstab" target="tester">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-tester-gwjwt" value="your JWT + session id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#E8730C;endArrow=block;endSize=8;endFill=1;fontSize=11;fontColor=#B85A08;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.33228;entryDx=0;entryDy=0;" edge="1" parent="1" source="tester" target="gwjwt">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
